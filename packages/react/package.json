{
  "name": "@mojilibrary/react",
  "version": "0.0.0",
  "private": true,
  "description": "Moji icons as React components: one cohesive outline style, tree-shakeable, accessible.",
  "license": "MIT",
  "author": "Jordan Philips",
  "homepage": "https://mojilibrary.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philipsjordan/mojilibrary-icons.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/philipsjordan/mojilibrary-icons/issues"
  },
  "keywords": [
    "icons",
    "svg",
    "outline-icons",
    "react",
    "mojilibrary"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js",
      "require": "./dist/icons/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=17"
  }
}
